FROM node:20-slim AS runner
WORKDIR /app

# Install OpenSSL for Prisma
RUN apt-get update -y && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production

# Install dependencies
COPY package.json pnpm-lock.yaml ./
COPY prisma ./prisma
RUN corepack enable pnpm && \
    pnpm install --frozen-lockfile --prod --ignore-scripts && \
    pnpm add tsx && \
    pnpm prisma generate && \
    rm -rf /root/.cache

# Create non-root user and logs directory
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker && \
    mkdir -p /app/logs && chown worker:nodejs /app/logs

# Copy worker source and shared modules
COPY --chown=worker:nodejs src/workers ./src/workers
COPY --chown=worker:nodejs src/lib ./src/lib
COPY --chown=worker:nodejs src/server ./src/server
COPY --chown=worker:nodejs src/analytics ./src/analytics
COPY --chown=worker:nodejs src/config ./src/config
# Product modules contribute queues and processors, so the worker needs them too.
COPY --chown=worker:nodejs src/modules ./src/modules
# env.js imports env-normalization.js at load time; without it the worker cannot boot.
COPY --chown=worker:nodejs src/env.js ./src/env.js
COPY --chown=worker:nodejs src/env-normalization.js ./src/env-normalization.js
COPY --chown=worker:nodejs tsconfig.json ./
COPY --chown=worker:nodejs public/data/disposable-domains.txt ./public/data/disposable-domains.txt
COPY --chown=worker:nodejs docker-entrypoint.worker.sh ./
# Do not rely on the host file mode surviving the build context.
RUN chmod +x docker-entrypoint.worker.sh

USER worker

EXPOSE 3001

# Seed the database, then start the worker
CMD ["./docker-entrypoint.worker.sh"]
